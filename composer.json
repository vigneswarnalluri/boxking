{
  "name": "construz/template",
  "description": "Construz - Construction Building PHP Template",
  "type": "project",
  "authors": [
    {
      "name": "Pixcels Themes"
    }
  ],
  "require": {
    "php": ">=8.0",
    "vlucas/phpdotenv": "^5.6",
    "monolog/monolog": "^3.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "@php -r \"is_dir('storage/logs') || mkdir('storage/logs', 0777, true);\""
    ],
    "post-update-cmd": [
      "@php -r \"is_dir('storage/logs') || mkdir('storage/logs', 0777, true);\""
    ]
  }
}
